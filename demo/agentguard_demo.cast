[0.024254, "o", "\u001b[H\u001b[2J\u001b[3J"]
[0.066149, "o", "\u001b[1mAgentGuard 0.2.0 — a minimal-privilege proxy for AI agent tool calls\u001b(B\u001b[m\r\n\u001b[2mWraps an MCP server; every tools/call is checked against policy, output\u001b(B\u001b[m\r\n"]
[0.669067, "o", "\u001b[2mis scanned for injected instructions and known secrets, and every\u001b(B\u001b[m\r\n"]
[1.271, "o", "\u001b[2mdecision lands in a hash-chained audit log.\u001b(B\u001b[m\r\n"]
[3.380617, "o", "\r\n\u001b[1m\u001b[32m== 1. Unprotected: agent asks for ~/.ssh/id_rsa, server just hands it over ==\u001b(B\u001b[m\r\n"]
[4.6715, "o", "\u001b[1;39m{\u001b[0m\u001b[34;1m\"jsonrpc\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"2.0\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[34;1m\"id\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m1\u001b[0m\u001b[1;39m,\u001b[0m\u001b[34;1m\"result\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;39m{\u001b[0m\u001b[34;1m\"protocolVersion\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"2024-11-05\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[34;1m\"serverInfo\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;39m{\u001b[0m\u001b[34;1m\"name\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"agentguard-demo-vulnerable-server\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[34;1m\"version\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"0.1.0\"\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\u001b[1;39m,\u001b[0m\u001b[34;1m\"capabilities\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;39m{\u001b[0m\u001b[34;1m\"tools\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;39m{}\u001b[0m\u001b[1;39m,\u001b[0m\u001b[34;1m\"resources\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;39m{}\u001b[0m\u001b[1;39m,\u001b[0m\u001b[34;1m\"prompts\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;39m{}\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\r\n"]
[4.722585, "o", "\u001b[1;39m{\u001b[0m\u001b[34;1m\"jsonrpc\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"2.0\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[34;1m\"id\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m2\u001b[0m\u001b[1;39m,\u001b[0m\u001b[34;1m\"result\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;39m{\u001b[0m\u001b[34;1m\"content\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;39m[\u001b[1;39m{\u001b[0m\u001b[34;1m\"type\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"text\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[34;1m\"text\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"-----BEGIN OPENSSH PRIVATE KEY-----FAKE-DEMO-KEY-----END OPENSSH PRIVATE KEY-----\\n\"\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\u001b[1;39m\u001b[1;39m]\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\r\n"]
