[0.032271, "o", "\u001b[H\u001b[J\u001b[3J"]
[0.033646, "o", "\u001b[1mAgentGuard — a minimal-privilege proxy for AI agent tool calls\u001b[m\u000f\r\n\u001b[2mWraps an MCP server; every tools/call is checked against policy, output\u001b[m\u000f\r\n"]
[0.63531, "o", "\u001b[2mis scanned for injected instructions and known secrets, and every\u001b[m\u000f\r\n"]
[1.237471, "o", "\u001b[2mdecision lands in a hash-chained audit log.\u001b[m\u000f\r\n"]
[3.349634, "o", "\r\n\u001b[1m\u001b[32m== 1. Unprotected: agent asks for ~/.ssh/id_rsa, server just hands it over ==\u001b[m\u000f\r\n"]
[4.638999, "o", "\u001b[1;39m{\u001b[0m\u001b[1;34m\"jsonrpc\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"2.0\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"id\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m1\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"result\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;39m{\u001b[0m\u001b[1;34m\"protocolVersion\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"2024-11-05\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"serverInfo\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;39m{\u001b[0m\u001b[1;34m\"name\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"agentguard-demo-vulnerable-server\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"version\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"0.1.0\"\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"capabilities\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;39m{\u001b[0m\u001b[1;34m\"tools\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;39m{}\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\r\n"]
[4.646737, "o", "\u001b[1;39m{\u001b[0m\u001b[1;34m\"jsonrpc\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"2.0\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"id\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m2\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"result\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;39m{\u001b[0m\u001b[1;34m\"content\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;39m[\u001b[1;39m{\u001b[0m\u001b[1;34m\"type\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"text\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"text\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"-----BEGIN OPENSSH PRIVATE KEY-----FAKE-DEMO-KEY-----END OPENSSH PRIVATE KEY-----\\n\"\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\u001b[1;39m\u001b[1;39m]\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\r\n"]
[6.14963, "o", "\r\n\u001b[1m\u001b[32m== 2. Same request, now through AgentGuard: blocked before it reaches the server ==\u001b[m\u000f\r\n"]
[7.513333, "o", "\u001b[1;39m{\u001b[0m\u001b[1;34m\"jsonrpc\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"2.0\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"id\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m2\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"error\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;39m{\u001b[0m\u001b[1;34m\"code\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m-32001\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"message\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"AgentGuard: blocked by policy — value '/tmp/tmp.zCVDw33EA8/.ssh/id_rsa' matches deny pattern '**/.ssh/**'\"\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\r\n"]
[7.531922, "o", "\u001b[1;39m{\u001b[0m\u001b[1;34m\"jsonrpc\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"2.0\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"id\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m1\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"result\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;39m{\u001b[0m\u001b[1;34m\"protocolVersion\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"2024-11-05\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"serverInfo\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;39m{\u001b[0m\u001b[1;34m\"name\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"agentguard-demo-vulnerable-server\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"version\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"0.1.0\"\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"capabilities\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;39m{\u001b[0m\u001b[1;34m\"tools\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;39m{}\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\r\n"]
[9.044823, "o", "\r\n\u001b[1m\u001b[32m== 3. An ordinary file read still works — this isn't a blanket deny ==\u001b[m\u000f\r\n"]
[10.376001, "o", "\u001b[1;39m{\u001b[0m\u001b[1;34m\"jsonrpc\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"2.0\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"id\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m1\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"result\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;39m{\u001b[0m\u001b[1;34m\"protocolVersion\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"2024-11-05\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"serverInfo\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;39m{\u001b[0m\u001b[1;34m\"name\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"agentguard-demo-vulnerable-server\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"version\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"0.1.0\"\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"capabilities\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;39m{\u001b[0m\u001b[1;34m\"tools\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;39m{}\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\r\n"]
[10.383344, "o", "\u001b[1;39m{\u001b[0m\u001b[1;34m\"jsonrpc\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"2.0\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"id\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m2\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"result\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;39m{\u001b[0m\u001b[1;34m\"content\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;39m[\u001b[1;39m{\u001b[0m\u001b[1;34m\"type\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"text\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"text\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"just some notes\\n\"\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\u001b[1;39m\u001b[1;39m]\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\r\n"]
